# ── Frontend Dockerfile ───────────────────────────────────────────────────────
# Streamlit chat UI on port 8501

FROM python:3.11-slim

WORKDIR /app

# Only install frontend dependencies
RUN pip install --no-cache-dir streamlit==1.40.1 httpx==0.28.0 python-dotenv==1.0.1

# Copy frontend source
COPY frontend/ ./frontend/

# Expose Streamlit port
EXPOSE 8501

# Streamlit config: disable telemetry, disable browser auto-open
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ENV STREAMLIT_SERVER_HEADLESS=true

CMD ["streamlit", "run", "frontend/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
